#!name=R-Store | 东方航空 - CEAIR
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/D/东方航空/ceair.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/app\.ceair\.com\/customize\/main\/(?>adScreen|shopping) data-type=text data="{}" status-code=200
^https?:\/\/app\.ceair\.com\/customize\/security\/update data-type=text data="" status-code=200
^https?:\/\/app\.ceair\.com\/itinerary\/home\/trip\/advertisement data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% app.ceair.com

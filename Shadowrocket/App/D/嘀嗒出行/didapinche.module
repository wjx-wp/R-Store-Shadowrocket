#!name=R-Store | 嘀嗒出行 - DIDA
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/D/嘀嗒出行/didapinche.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/capis(-\w+)?\.didapinche\.com\/ad\/ - reject

[Map Local]
^https?:\/\/capis(-\w+)?\.didapinche\.com\/publish\/api\/upgrade data-type=text data="{}" status-code=200
^https?:\/\/www\.didapinche\.com\/app\/adstat\/ data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% www.didapinche.com

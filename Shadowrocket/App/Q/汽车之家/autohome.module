#!name=R-Store | 汽车之家 - AUTOHOME
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/Q/汽车之家/autohome.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN, adm0.autoimg.cn, REJECT
DOMAIN, adm1.autoimg.cn, REJECT
DOMAIN, adm2.autoimg.cn, REJECT
DOMAIN, adm3.autoimg.cn, REJECT
DOMAIN, al.autohome.com.cn, REJECT
DOMAIN, rd.autohome.com.cn, REJECT
DOMAIN, rdx.autohome.com.cn, REJECT
DOMAIN-KEYWORD, adproxy.autohome.com, REJECT
DOMAIN-KEYWORD, applogapi.autohome.com, REJECT
DOMAIN-KEYWORD, collectionpv.che168.com, REJECT
DOMAIN-SUFFIX, 33.autohome.com.cn, REJECT
DOMAIN-SUFFIX, activity.app.autohome.com.cn, REJECT
DOMAIN-SUFFIX, applogapi.autohome.com.cn, REJECT
DOMAIN-SUFFIX, c.autohome.com.cn, REJECT
DOMAIN-SUFFIX, cmx.autohome.com.cn, REJECT
DOMAIN-SUFFIX, dspmnt.autohome.com.cn, REJECT
DOMAIN-SUFFIX, pcd.autohome.com.cn, REJECT
DOMAIN-SUFFIX, pcmx.autohome.com.cn, REJECT
DOMAIN-SUFFIX, public.app.autohome.com.cn, REJECT
DOMAIN-SUFFIX, push.app.autohome.com.cn, REJECT
DOMAIN-SUFFIX, pv.alert.autohome.com.cn, REJECT
DOMAIN-SUFFIX, pvx.autohome.com.cn, REJECT

[Map Local]
^https?:\/\/pcmx\.autohome\.com\.cn\/queryCreativeList data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% app2.autoimg.cn, pcmx.autohome.com.cn

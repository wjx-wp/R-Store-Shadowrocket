#!name=R-Store | 全球购骑士特权 - BLACKUNIQUE
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/Q/全球购骑士特权/blackunique.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/facade-api\.black-unique\.com\/advertise\/v\d\/get\?.* data-type=text data="{}" status-code=200
^https?:\/\/facade-api\.black-unique\.com\/app\/v\d\/startScreen\?.* data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% facade-api.black-unique.com

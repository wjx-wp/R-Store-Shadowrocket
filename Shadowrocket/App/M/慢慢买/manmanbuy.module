# upstream: Rule/Surge/Adblock/App/M/慢慢买/manmanbuy.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/apapia-sqk\.manmanbuy\.com\/index_json\.ashx$ data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% apapia-sqk.manmanbuy.com

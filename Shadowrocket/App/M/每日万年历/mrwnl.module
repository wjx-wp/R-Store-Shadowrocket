# upstream: Rule/Surge/Adblock/App/M/每日万年历/mrwnl.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/app-cdn\.2q10\.com\/app\/ical\/honored\? - reject

[MITM]
hostname = %APPEND% app-cdn.2q10.com

# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/api\.mgzf\.com\/renter-operation\/home\/startHomePage - reject

[MITM]
hostname = %APPEND% api.mgzf.com

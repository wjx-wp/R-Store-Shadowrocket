# upstream: Rule/Surge/Adblock/App/X/小熊拦截/xiaoxiong.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/spamblocker-api\.zeekstudio\.com\/checkVersion - reject
^https?:\/\/spamblocker-api\.zeekstudio\.com\/profile - reject

[MITM]
hostname = %APPEND% spamblocker-api.zeekstudio.com

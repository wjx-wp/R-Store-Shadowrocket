#!name=R-Store | 迅雷 - XUNLEI
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/X/迅雷/xunlei.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN, adsp.xunlei.com, REJECT
DOMAIN, etl.xlmc.sandai.net, REJECT

[Map Local]
^https?:\/\/api-shoulei-ssl\.xunlei\.com\/flowhub\/v\d\/slots:batchGet data-type=text data="" status-code=200
^https?:\/\/images\.client\.vip\.xunlei\.com(\/.+)?\/advert\/ data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% api-shoulei-ssl.xunlei.com, conf-m-ssl.xunlei.com, images.client.vip.xunlei.com

#!name=R-Store | 晓晓优选 - XXYX
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/X/晓晓优选/xxyx.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN-SUFFIX, 1rtb.net, REJECT
DOMAIN-SUFFIX, ad.richmob.cn, REJECT
DOMAIN-SUFFIX, adwangmai.com, REJECT
DOMAIN-SUFFIX, datads.cn, REJECT
DOMAIN-SUFFIX, fancyapi.com, REJECT
DOMAIN-SUFFIX, yfanads.com, REJECT

[URL Rewrite]
^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/\w+_banner - reject
^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/activity\/show - reject
^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/agent_ad - reject
^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/client\/invite\/phone\/activity\/popup - reject
^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/client\/urban\/activity\/index\/data - reject
^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/get_.*_ad - reject

[MITM]
hostname = %APPEND% xxyx-client-api.xiaoxiaoyouxuan.com

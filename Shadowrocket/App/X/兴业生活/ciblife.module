# upstream: Rule/Surge/Adblock/App/X/兴业生活/ciblife.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/file\.cibfintech\.com\/file\/M0[1-9]{1}\/.*\.zip - reject

[MITM]
hostname = %APPEND% file.cibfintech.com

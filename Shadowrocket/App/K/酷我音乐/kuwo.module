#!name=R-Store | 酷我音乐 - KUWO
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/K/酷我音乐/kuwo.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN-SUFFIX, c.kuwo.cn, REJECT
DOMAIN-SUFFIX, deliver.kuwo.cn, REJECT
DOMAIN-SUFFIX, g.koowo.com, REJECT
DOMAIN-SUFFIX, game.kuwo.cn, REJECT
DOMAIN-SUFFIX, kuwoyy.com, REJECT
DOMAIN-SUFFIX, kwmsg.kuwo.cn, REJECT
DOMAIN-SUFFIX, mobilead.kuwo.cn, REJECT
DOMAIN-SUFFIX, msclick2.kuwo.cn, REJECT
DOMAIN-SUFFIX, msphoneclick.kuwo.cn, REJECT
DOMAIN-SUFFIX, rich.kuwo.cn, REJECT
DOMAIN-SUFFIX, updatepage.kuwo.cn, REJECT
DOMAIN-SUFFIX, wa.kuwo.cn, REJECT
DOMAIN-SUFFIX, webstat.kuwo.cn, REJECT
IP-CIDR, 111.206.98.63/32, REJECT

[URL Rewrite]
^https?:\/\/vip\d\.kuwo\.cn\/vip\/v\d\/sysinfo\?op=getRePayAndDoPayBox - reject
^https?:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/album\/adBar - reject
^https?:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/app\/(?>pasterAdvert|startup) - reject
^https?:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/app\/newMenuList\/menuListInfo - reject
^https?:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/user\/freeMode - reject

[Map Local]
^https?:\/\/appi\.kuwo\.cn\/kuwopay\/personal\/cells data-type=text data="{}" status-code=200
^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p\?op=get_advertright_endtime data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% appi.kuwo.cn, audiobookpay.kuwo.cn, mgxhtj.kuwo.cn, musicpay.kuwo.cn, nmobi.kuwo.cn, searchrecterm.kuwo.cn, wapi.kuwo.cn

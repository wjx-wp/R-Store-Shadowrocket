# upstream: Rule/Surge/Adblock/App/0-9/51信用卡管家/u51.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/api\.u51\.com\/liabilitygateway\/api\/v\d\/homepage\/liabilityline data-type=text data="{}" status-code=200
^https?:\/\/api\.u51\.com\/rs-resys\/api\/v\d\/recommend data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% api.u51.com

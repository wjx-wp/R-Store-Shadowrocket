#!name=R-Store | 中国农业银行 - ABCHINA
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/Z/中国农业银行/abc.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN, firefly.abchina.com.cn, REJECT
DOMAIN, imc.abchina.com.cn, REJECT
DOMAIN, msmp.abchina.com.cn, REJECT

[Map Local]
^https?:\/\/mall\.abchina\.com\.cn\/pips\/EbizccmClientServer\/PIPSPopupAdvertisement data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% mall.abchina.com.cn, mobilepaas.abchina.com.cn

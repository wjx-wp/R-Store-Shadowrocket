#!name=R-Store | 中国电信 - 189
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/Z/中国电信/189.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN, ad.21cn.com, REJECT
DOMAIN, ad.k.21cn.com, REJECT
DOMAIN, admarket.21cn.com, REJECT
DOMAIN, adshows.21cn.com, REJECT
DOMAIN, appgo.189.cn, REJECT
DOMAIN, appgoad.189.cn, REJECT
DOMAIN, appupdates.189.cn, REJECT
IP-CIDR, 122.229.29.89/32, REJECT
IP-CIDR, 122.229.8.47/32, REJECT

[URL Rewrite]
^https?:\/\/cloud\.189\.cn\/include\/splash\/ - reject

[Map Local]
^https?:\/\/appkefu\.189\.cn(:\d+)?\/query\/myWallet\/ data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% appkefu.189.cn, cloud.189.cn, zt-app.go189.cn

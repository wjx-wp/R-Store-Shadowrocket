#!name=R-Store | 中关村在线 - ZOL
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/Z/中关村在线/zol.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN-SUFFIX, afp.zol-img.com.cn, REJECT
DOMAIN-SUFFIX, apppv.zol.com.cn, REJECT
DOMAIN-SUFFIX, cpro.zol.com.cn, REJECT
DOMAIN-SUFFIX, dynamic.zol.com.cn, REJECT
DOMAIN-SUFFIX, imp.zol.com.cn, REJECT
DOMAIN-SUFFIX, js.zol.com.cn, REJECT
DOMAIN-SUFFIX, mstat.zol.com.cn, REJECT
DOMAIN-SUFFIX, pic.zol-img.com.cn, REJECT
DOMAIN-SUFFIX, pv.zol.com.cn, REJECT
DOMAIN-SUFFIX, pvc.zol.com.cn, REJECT
DOMAIN-SUFFIX, pvm.zol.com.cn, REJECT
DOMAIN-SUFFIX, pvmsite.zol.com.cn, REJECT
DOMAIN-SUFFIX, pvnapp.zol.com.cn, REJECT
DOMAIN-SUFFIX, pvsite.zol.com.cn, REJECT
DOMAIN-SUFFIX, pvtest.zol.com.cn, REJECT
DOMAIN-SUFFIX, wappv.zol.com.cn, REJECT
DOMAIN-SUFFIX, ydjs.zol.com.cn, REJECT

[Map Local]
^https?:\/\/apicloud\.zol\.com\.cn\/Article\/WapLaunchLogo data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% apicloud.zol.com.cn

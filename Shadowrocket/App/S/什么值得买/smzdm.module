#!name=R-Store | 什么值得买 - SMZDM
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/S/什么值得买/smzdm.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN, analytics-api.smzdm.com, REJECT
DOMAIN, api.zuihuimai.com, REJECT
DOMAIN, ynuf.aliapp.org, REJECT

[Map Local]
^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/other_modul\? data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% app-api.smzdm.com, article-api.smzdm.com, haojia-api.smzdm.com, haojia.m.smzdm.com, homepage-api.smzdm.com, post.m.smzdm.com, qianbao.smzdm.com, s-api.smzdm.com, user-api.smzdm.com

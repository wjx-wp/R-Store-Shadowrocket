# upstream: Rule/Surge/Adblock/App/S/神仙外企/sxwq.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/backservice\.offerxiansheng\.com\/api\/backend-service\/bkd\/version-control\/new-version data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% backservice.offerxiansheng.com

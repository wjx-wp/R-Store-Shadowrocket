#!name=R-Store | 苏打校园 - SODALIFE
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/S/苏打校园/sodalife.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/api\.sodalife\.xyz\/hydr\/v\d\/poster\/posters data-type=text data="{}" status-code=200
^https?:\/\/api\.sodalife\.xyz\/v\d\/goods data-type=text data="{}" status-code=200
^https?:\/\/api\.sodalife\.xyz\/v\d\/posters\?location=SODA_APP%3AHOME%3ABOTTOM data-type=text data="{}" status-code=200
^https?:\/\/api\.sodalife\.xyz\/v\d\/posters\?location=SODA_APP%3AHOME%3ACENTER data-type=text data="{}" status-code=200
^https?:\/\/api\.sodalife\.xyz\/v\d\/posters\?location=SODA_APP%3AHOME%3ATOP data-type=text data="{}" status-code=200
^https?:\/\/api\.sodalife\.xyz\/v\d\/posters\?location=SODA_APP%3AMINE%3ABOTTOM data-type=text data="{}" status-code=200
^https?:\/\/api\.sodalife\.xyz\/v\d\/posters\?location=SODA_APP%3AREWARDS%3ACENTER data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% api.sodalife.xyz

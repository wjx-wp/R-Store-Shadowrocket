#!name=R-Store | 神舟租车 - ZUCHE
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/S/神州租车/zuche.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/apiproxy\.zuche\.com\/action\/carrctapi\/brand\/area\/advertising - reject

[Map Local]
^https?:\/\/apiproxy\.zuche\.com\/action\/carrctapi\/order\/appStartInit data-type=text data="{}" status-code=200
^https?:\/\/apiproxy\.zuche\.com\/resource\/cardes\/guide data-type=text data="{}" status-code=200
^https?:\/\/apiproxy\.zuche\.com\/resource\/cardes\/toufang\/marketing data-type=text data="{}" status-code=200
^https?:\/\/apiproxy\.zuche\.com\/resource\/carrctapi\/base\/versionInfo data-type=text data="{}" status-code=200
^https?:\/\/apiproxy\.zuche\.com\/resource\/carrctapi\/order\/homeCommonTips data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% apiproxy.zuche.com

#!name=R-Store | 易捷加油 - EJOY
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/Y/易捷加油/ejoy.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/a\.sinopecsales\.com\/app\/cms data-type=text data="{}" status-code=200
^https?:\/\/a\.sinopecsales\.com\/app\/update\/(?>AppOpenConfig|AppVersion) data-type=text data="{}" status-code=200
^https?:\/\/a\.sinopecsales\.com\/app\/wff\/ data-type=text data="[]" status-code=200

[MITM]
hostname = %APPEND% a.sinopecsales.com

#!name=R-Store | 虎扑 - HUPU
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/H/虎扑/hupu.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN, adx-api.hupu.com, REJECT
DOMAIN, adx.hupu.com, REJECT
DOMAIN, goblin.hupu.com, REJECT

[URL Rewrite]
^https?:\/\/goblin\.hupu\.com\/.+\/interfaceAd\/ - reject

[Map Local]
^https?:\/\/business\.msstatic\.com\/advertiser data-type=text data="" status-code=200
^https?:\/\/games\.mobileapi\.hupu\.com(\/.+)?\/(interfaceAd|status\/init) data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% business.msstatic.com, du.hupucdn.com, games.mobileapi.hupu.com, goblin.hupu.com

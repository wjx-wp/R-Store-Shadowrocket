# upstream: Rule/Surge/Adblock/App/H/好好住/haohaozhu.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/api\.haohaozhu\.cn\/index\.php\/home\/AppInit\/getStartPhoto - reject

[MITM]
hostname = %APPEND% api.haohaozhu.cn

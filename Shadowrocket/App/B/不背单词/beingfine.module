#!name=R-Store | 不背单词 - BEINGFINE
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/B/不背单词/beingfine.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/(img|hwimg)\.beingfine\.cn\/(?>float_button|card) data-type=text data="{}" status-code=200
^https?:\/\/hwimg\.beingfine\.cn\/(?>card|Channel) data-type=text data="{}" status-code=200
^https?:\/\/learnywhere\.cn\/api\/activity\/23\/423dsj\/inapp\/bb\/promote data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% hwimg.beingfine.cn, learnywhere.cn

#!name=R-Store | 宝宝树 - BABYTREE
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/B/宝宝树/babytree.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN, ads.babytree.com, REJECT
DOMAIN, adx-backend.babytree.com, REJECT
DOMAIN, adx.babytree.com, REJECT
DOMAIN, bbtads.babytree.com, REJECT
DOMAIN, m.meitun.com, REJECT
DOMAIN, mobads-pre-config.cdn.bcebos.com, REJECT
DOMAIN, titan.babytree.com, REJECT
DOMAIN, titan01.babytree.com, REJECT
DOMAIN, tracking.babytree.com, REJECT

[URL Rewrite]
^https?:\/\/api\.babytree\.com\/api\/(?>advertising|mobile_activity) - reject
^https?:\/\/api\.babytree\.com\/preg_intf\/index_content\/index_banner - reject
^https?:\/\/go\.babytree\.com\/go_pregnancy\/api\/app_index\/get_ceramic_chip_area - reject
^https?:\/\/go\.babytree\.com\/go_pregnancy\/api\/cms_second_tab\/topic_tab_list - reject
^https?:\/\/go\.babytree\.com\/go_pregnancy\/api\/feeds - reject
^https?:\/\/go\.babytree\.com\/go_pregnancy\/api\/index_activity - reject
^https?:\/\/go\.babytree\.com\/go_tool\/api\/feeding_record\/get_home_banner_info - reject
^https?:\/\/go\.babytree\.com\/go_tool\/api\/tools\/get_third_privacy_msgbox_list - reject

[Map Local]
^https?:\/\/mapiweb\.babytree\.com\/newapi\/luban\/behavior\/receive data-type=text data="" status-code=200
^https?:\/\/plough\.babytree\.com\/plough\.do data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% api.babytree.com, go.babytree.com, mapiweb.babytree.com, plough.babytree.com

#!name=R-Store | 人民日报 - PEOPLEAPP
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/R/人民日报/peopleapp.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/app\.peopleapp\.com\/Api\/\d+/HomeApi\/(?>adv|getAdvertImage) - reject
^https?:\/\/stat\.peopleapp\.com\/ - reject

[Map Local]
^https?:\/\/adstatic\.peopleapp\.com\/upload\/AppLoad\/.*.(?>jpg|png) data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% adstatic.peopleapp.com, app.peopleapp.com, stat.peopleapp.com

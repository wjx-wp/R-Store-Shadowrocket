#!name=R-Store | 金山词霸 - ICIBA
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/J/金山词霸/iciba.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN, ad-stat.ksosoft.com, REJECT
DOMAIN, counter.kingsoft.com, REJECT
DOMAIN, counter.ksosoft.com, REJECT
DOMAIN, img.auction-ads.wpscdn.cn, REJECT
DOMAIN, minfo.wps.cn, REJECT
DOMAIN, mobad.ijinshan.com, REJECT
DOMAIN, ups.ksmobile.net, REJECT
DOMAIN, ws.ksmobile.net, REJECT

[URL Rewrite]
^https?:\/\/dict-mobile\.iciba\.com\/interface\/index\.php\?.+(?>c=ad|collectFeedsAdShowCount|KSFeedsAdCardViewController) - reject
^https?:\/\/mobile-pic\.cache\.iciba\.com\/feeds_ad\/ - reject

[Map Local]
^https?:\/\/service\.iciba\.com\/popo\/open\/screens\/v\d\?adjson data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% dict-mobile.iciba.com, mobile-pic.cache.iciba.com, service.iciba.com

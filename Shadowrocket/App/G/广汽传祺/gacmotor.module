#!name=R-Store | 广汽传祺 - GACMOTOR
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/G/广汽传祺/gacmotor.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/gsp\.gacmotor\.com\/gateway\/app-api\/app\/version\/latestupdate\?flatform=2&innerVersion= data-type=text data="{}" status-code=200
^https?:\/\/gsp\.gacmotor\.com\/gateway\/webapi\/baseinfo\/advertise\/getAdvertiseByPositionCode\?positionCode=1 data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% gsp.gacmotor.com

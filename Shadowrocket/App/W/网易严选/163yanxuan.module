#!name=R-Store | 网易严选 - 163YANXUAN
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/W/网易严选/163yanxuan.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/m\.you\.163\.com\/activity\/popWindow - reject
^https?:\/\/support\.you\.163\.com\/appversync\/check - reject
^https?:\/\/yanxuan\.nosdn\.127\.net\/.*\.mp4 - reject

[Map Local]
^https?:\/\/support\.you\.163\.com\/xhr\/boot\/getBootMedia data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% m.you.163.com, support.you.163.com, yanxuan.nosdn.127.net

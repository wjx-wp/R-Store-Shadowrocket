#!name=R-Store | 牛听听 - BENEWTECH
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/N/牛听听/benewtech.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/gateway\.benewtech\.cn\/resources-app\/app\/startup\/prepage data-type=text data="{}" status-code=200
^https?:\/\/ntt-app\.benewtech\.cn\/v\d\/user\/\d+\/messages\/event data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% gateway.benewtech.cn, ntt-app.benewtech.cn

#!name=R-Store | 两步路 - 2BULU
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/App/L/两步路/2bulu.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/helper\.2bulu\.com(\/v\d)?\/advert - reject
^https?:\/\/helper\.2bulu\.com\/(?>greenPea\/queryTasks|proSpecial\/allData|saveSplashFrequencyStatistics|getPopInfo|getAppEntranceConfig|promote\/list|getSplash|outing\/reqFoundNewList|outing\/reqIndex) - reject

[Map Local]
^https?:\/\/helper\.2bulu\.com\/get(?>Version|AgreementUpdate)Info data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% helper.2bulu.com

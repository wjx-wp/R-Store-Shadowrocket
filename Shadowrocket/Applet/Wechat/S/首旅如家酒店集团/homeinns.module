#!name=R-Store | homeinns
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/Applet/Wechat/S/首旅如家酒店集团/homeinns.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/app\.homeinns\.com\/api\/v\d\/(?>index|local) data-type=text data="{}" status-code=200
^https?:\/\/wx\.bthhotels\.com\/miniapp\/weixin\/v\d\/home\/index_banner data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% app.homeinns.com, wx.bthhotels.com

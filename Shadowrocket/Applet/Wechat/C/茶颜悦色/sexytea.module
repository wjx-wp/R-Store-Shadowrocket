# upstream: Rule/Surge/Adblock/Applet/Wechat/C/茶颜悦色/sexytea.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/miniapp\.sexytea2013\.com\/cms\/slot\/byCode\?code=MALL_INDEX_SLOT data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% miniapp.sexytea2013.com

[URL Rewrite]
^https?:\/\/api-marketing\.zhinengxiyifang\.cn\/api\/v\d\/cloudcode\/wechat\/bid - reject

[MITM]
hostname = %APPEND% api-marketing.zhinengxiyifang.cn

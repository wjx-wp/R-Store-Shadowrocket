#!name=R-Store | ykc
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/Applet/Wechat/Y/云快充/ykc.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Rule]
DOMAIN, et.ykccn.com, REJECT

[URL Rewrite]
^https?:\/\/gw3\.ykccn\.com\/activityServer\/app\/commandAd - reject

[Map Local]
^https?:\/\/gw3\.ykccn\.com\/api\/omp\/mt\/appAdvertising\/ data-type=text data="{}" status-code=200
^https?:\/\/gw3\.ykccn\.com\/api\/omp\/mt\/charge\/activity\/package\/newest data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% gw3.ykccn.com, web-stable-cdn.ykccn.com

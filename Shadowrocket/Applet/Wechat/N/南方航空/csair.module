#!name=R-Store | csair
#!desc=Shadowrocket network-only port; upstream JS deliberately omitted; not device-verified
#!author=zirawell (upstream) & wjx-wp (adaptation)
#!homepage=https://github.com/wjx-wp/R-Store-Shadowrocket
# upstream: Rule/Surge/Adblock/Applet/Wechat/N/南方航空/csair.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[URL Rewrite]
^https?:\/\/extra\.csair\.com\/extraClient\/data\/mytrip\/getTripAdvertisement - reject
^https?:\/\/wxapi\.csair\.com\/mini\/api\/advertisement\/ - reject

[Map Local]
^https?:\/\/wxapi\.csair\.com\/mini\/api\/adVerTiSing\/(?!getPersonalCenterAdList) data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% extra.csair.com, wxapi.csair.com

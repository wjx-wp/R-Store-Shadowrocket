# upstream: Rule/Surge/Adblock/Applet/Wechat/W/问卷星/wjx.sgmodule
# IMPORTANT: No upstream JavaScript is executed by this module.
# Enable only the App modules you need. Requires HTTPS MITM for URL Rewrite / Map Local.

[Map Local]
^https?:\/\/image\.wjx\.cn\/joinnew\/js\/joinawardactivitymobo data-type=text data="{}" status-code=200

[MITM]
hostname = %APPEND% image.wjx.cn, kaoshi.wjx.top
